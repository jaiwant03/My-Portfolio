# ============================================================
# SERVER ENVIRONMENT VARIABLES
# Copy this file to .env for local development.
# .env is git-ignored and must NEVER be committed.
#
# In production (Render): add each variable in
#   Dashboard → Your Service → Environment → Add Environment Variable
# ============================================================

# ── Server ───────────────────────────────────────────────────
# Render injects PORT automatically — only needed locally.
PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────────
# Create a cluster at https://cloud.mongodb.com, then:
#   Database Access → create user
#   Network Access  → allow 0.0.0.0/0 (required for Render)
#   Connect         → copy the connection string, replace <password>
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>

# ── JWT ───────────────────────────────────────────────────────
# Any long random string — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ── Google OAuth ──────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com
#   APIs & Services → Credentials → OAuth 2.0 Client IDs
#
# Authorised JavaScript origins:
#   http://localhost:5000
#   https://your-render-service.onrender.com
#
# Authorised redirect URIs:
#   http://localhost:5000/auth/google/callback          (development)
#   https://your-render-service.onrender.com/auth/google/callback  (production)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Callback & client URLs ────────────────────────────────────
# Development
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
CLIENT_URL=http://localhost:5173

# Production (set these in Render's environment panel instead of here)
# GOOGLE_CALLBACK_URL=https://your-render-service.onrender.com/auth/google/callback
# CLIENT_URL=https://your-app.vercel.app
